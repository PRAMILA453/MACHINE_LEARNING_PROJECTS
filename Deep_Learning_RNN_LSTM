# ============================================================
# 🌡️ BANGALORE TEMPERATURE - RNN vs LSTM
# HYPERPARAMETER COMBINATIONS
# ============================================================

# 1. IMPORTS
import numpy as np,pandas as pd,matplotlib.pyplot as plt
from google.colab import files
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_absolute_error,mean_squared_error,r2_score,mean_absolute_percentage_error
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import SimpleRNN,LSTM,Dense
from tensorflow.keras.optimizers import Adam
from tensorflow.keras.callbacks import EarlyStopping

# 2. LOAD DATA
files.upload()
df=pd.read_csv("india_2000_2024_daily_weather.csv")
df.columns=df.columns.str.strip().str.lower().str.replace(" ","_")  # Clean column names: remove spaces, convert to lowercase, replace spaces with _
df["date"]=pd.to_datetime(df["date"])  # Convert date column into date format
df=df[df.city.str.lower()=="bangalore"][["date","temperature_2m_max"]].dropna().sort_values("date")  # Keep Bangalore data, select date and temperature, remove missing values, and sort by date
temp=df.temperature_2m_max.values.reshape(-1,1)  # Get temperature values and convert them into a column formatprint("Data:",df.shape)

# 3. TRAIN / TEST
days=7
split=int(len(temp)*.8)
train=temp[:split]             # Take first 80% data for training-(1000-800=794)
test=temp[split-days:]         # Take remaining 20% data + previous 7 days for testing

# 4. SCALING
scaler=MinMaxScaler()
train=scaler.fit_transform(train)
test=scaler.transform(test)

# 5. SEQUENCES
def make_seq(data):                         # Create 7-day input and next-day output
    X,y=[],[]                               # X = inputs, y = targets
    for i in range(len(data)-days):         # Move through all possible sequences
        X.append(data[i:i+days])            # Take previous 7 days as input
        y.append(data[i+days])              # Take the next day as target
    return np.array(X),np.array(y)          # Convert lists to NumPy arraysX = [ [Day1, Day2, Day3, Day4, Day5, Day6, Day7], [Day2, Day3, Day4, Day5, Day6, Day7, Day8],

X_train,y_train=make_seq(train)             # Create training sequences
X_test,y_test=make_seq(test)                # Create testing sequences

# ============================================================
# 6. CHOOSE HYPERPARAMETERS
# ============================================================

units=32
epochs=30
batch=32
lr=0.001

# -------- COMBINATION 1 --------
# units=32
# epochs=30
# batch=32
# lr=0.001

# -------- COMBINATION 2 --------
# units=64
# epochs=30
# batch=32
# lr=0.001

# -------- COMBINATION 3 --------
# units=32
# epochs=50
# batch=32
# lr=0.001

# -------- COMBINATION 4 --------
# units=64
# epochs=50
# batch=16
# lr=0.0005

# -------- COMBINATION 5 --------
# units=128
# epochs=50
# batch=32
# lr=0.0005

# ============================================================
# 7. RNN
# ============================================================

rnn=Sequential([
    SimpleRNN(units,activation="tanh",input_shape=(days,1)),
    Dense(1)
])

rnn.compile(optimizer=Adam(learning_rate=lr),loss="mse")

stop=EarlyStopping(monitor="val_loss",patience=5,
                   restore_best_weights=True)

rh=rnn.fit(X_train,y_train,
           epochs=epochs,
           batch_size=batch,
           validation_split=.1,
           callbacks=[stop],verbose=0)

# ============================================================
# 8. LSTM
# ============================================================

lstm=Sequential([
    LSTM(units,activation="tanh",input_shape=(days,1)),
    Dense(1)
])

lstm.compile(optimizer=Adam(learning_rate=lr),loss="mse")

lh=lstm.fit(X_train,y_train,
            epochs=epochs,
            batch_size=batch,
            validation_split=.1,
            callbacks=[stop],verbose=0)

# ============================================================
# 9. PREDICTION
# ============================================================
# X_test = previous 7 days given to the models
# y_test = actual next-day temperatures

actual=scaler.inverse_transform(y_test)# Convert actual scaled test temperatures back to original °C values

rp=scaler.inverse_transform(rnn.predict(X_test,verbose=0))# RNN predicts test temperatures, then convert predictions back to °C

lp=scaler.inverse_transform(lstm.predict(X_test,verbose=0)) # LSTM predicts test temperatures, then convert predictions back to °C
# ============================================================
# 10. METRICS
# ============================================================

def metrics(a,p):                                      # Calculate model performance,A=actual,p=predicted

    mae=mean_absolute_error(a,p)                       # Mean Absolute Error
    rmse=np.sqrt(mean_squared_error(a,p))              # Root Mean Squared Error
    r2=r2_score(a,p)                                   # R² score
    mape=mean_absolute_percentage_error(a,p)*100       # Mean Absolute Percentage Error
    return mae,rmse,r2,mape,100-mape                   # Return all metrics

rm,rr,rx,rmape,racc=metrics(actual,rp)                 # Calculate RNN pred=rp metrics
#rm  → MAE, rr → RMSE, rx→ R², rmape→ MAPE, racc→ Accuracy
lm,lr2,lx,lmape,lacc=metrics(actual,lp)                # Calculate LSTM prediction=lp metrics

print("\n================ RESULTS ================")
print(f"RNN  : MAE={rm:.2f} | RMSE={rr:.2f} | R²={rx:.3f} | MAPE={rmape:.2f}% | Accuracy={racc:.2f}%")
print(f"LSTM : MAE={lm:.2f} | RMSE={lr2:.2f} | R²={lx:.3f} | MAPE={lmape:.2f}% | Accuracy={lacc:.2f}%")

# ============================================================
# 11. ACTUAL VS PREDICTED
# ============================================================

plt.figure(figsize=(10,5))
plt.plot(actual[:100],label="Actual")
plt.plot(rp[:100],label="RNN")
plt.plot(lp[:100],label="LSTM")
plt.xlabel("Days")
plt.ylabel("Temperature °C")
plt.title("Bangalore Temperature - RNN vs LSTM")
plt.legend()
plt.show()

# ============================================================
# 12. LOSS
# ============================================================

plt.figure(figsize=(10,5))
plt.plot(rh.history["loss"],label="RNN Train")
plt.plot(rh.history["val_loss"],label="RNN Validation")
plt.plot(lh.history["loss"],label="LSTM Train")
plt.plot(lh.history["val_loss"],label="LSTM Validation")
plt.xlabel("Epoch")
plt.ylabel("MSE Loss")
plt.title("RNN vs LSTM Loss")
plt.legend()
plt.show()

# ============================================================
# 13. NEXT-DAY PREDICTION
# ============================================================

last7=df.temperature_2m_max.values[-days:].reshape(-1,1) # Take the last 7 days of temperature as input

inp=scaler.transform(last7).reshape(1,days,1) # Scale the last 7 days and reshape them 1-sequence,days -7,1-feature

rn=scaler.inverse_transform(rnn.predict(inp,verbose=0))[0,0] # Predict next temperature using RNN and convert it back to °C

ln=scaler.inverse_transform(lstm.predict(inp,verbose=0))[0,0]# Predict next temperature using LSTM and convert it back to °C

print("\n================ NEXT DAY ================")
print("Last 7 days:",last7.flatten().round(2))
print("RNN :",round(rn,2),"°C")
print("LSTM:",round(ln,2),"°C")
