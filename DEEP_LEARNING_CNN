# ============================================================
# 7. BUILD CNN
# ============================================================
model=Sequential()                              # Create CNN model

model.add(Conv2D(
    filters1,(3,3),                             # Number of filters and filter size
    activation="relu",                          # Add ReLU activation
    input_shape=(150,150,3)                     # Input image size: 150x150 RGB
))

model.add(MaxPooling2D(2,2))                    # Reduce image size
model.add(Conv2D(
    filters2,(3,3),                             # Add second convolution layer
    activation="relu"                           # Add ReLU activation
))

model.add(MaxPooling2D(2,2))                    # Reduce image size again
model.add(Flatten())                            # Convert feature maps into 1D
model.add(Dense(
    dense_neurons,                              # Number of neurons
    activation="relu"                           # Add ReLU activation
))

model.add(Dropout(dropout))                     # Randomly drop neurons to reduce overfitting
model.add(Dense(
    1,                                          # One output neuron
    activation="sigmoid"                        # Output probability between 0 and 1
))
# ============================================================
# 8. COMPILE CNN
# ============================================================
model.compile(
    optimizer=Adam(learning_rate=learning_rate),
    loss="binary_crossentropy",
    metrics=["accuracy"]
)


# ============================================================
# 9. EARLY STOPPING
# ============================================================
early_stop=EarlyStopping(
    monitor="val_loss",
    patience=3,
    restore_best_weights=True
)


# ============================================================
# 10. TRAIN CNN
# ============================================================
history=model.fit(
    train_data,
    epochs=epochs,
    batch_size=batch_size,
    validation_data=val_data,
    callbacks=[early_stop],
    verbose=1
)


# ============================================================
# 11. PREDICTION
# ============================================================
probability=model.predict(test_data)
y_pred=(probability>=0.5).astype(int).ravel()#ravel() simply converts the result into a 1-dimensional array.


# ============================================================
# 12. ACCURACY
# ============================================================
accuracy=accuracy_score(
    test_data.classes,       # Actual labels of test images- #Actual:     0  1  1  0 #Predicted:  0  1  0  0
    y_pred                   # Predicted labels from the CNN
)

print("\n===== FINAL RESULT =====")
print("Accuracy:",round(accuracy*100,2),"%")


