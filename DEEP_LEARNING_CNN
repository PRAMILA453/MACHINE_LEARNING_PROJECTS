for i in range(4):                             # Display the first 4 images
    plt.subplot(2,2,i+1)                        # Create a 2x2 grid for the images
    plt.imshow(images[i])                      # Display the current image
    plt.title("PNEUMONIA" if labels[i]==1      # Show PNEUMONIA if label is 1
              else "NORMAL")                   # Otherwise show NORMAL
    plt.axis("off")                            # Hide x-axis and y-axis

plt.show()
