# ============================================================
# 3. DATASET PATH
# ============================================================
train_path="/content/CNN_Pneumonia/chest_xray/train"
test_path="/content/CNN_Pneumonia/chest_xray/test"


# ============================================================
# 4. PREPARE IMAGE DATA
# ============================================================
datagen=ImageDataGenerator(
    rescale=1./255,              # Convert pixel values from 0-255 to 0-1
    validation_split=0.2         # Keep 20% of training images for validation
)

train_data=datagen.flow_from_directory(
    train_path,                  # Path to the training image folder
    target_size=(150,150),       # Resize every image to 150x150 pixels
    batch_size=32,               # Process 32 images at a time
    class_mode="binary",         # Use binary labels for 2 classes
    subset="training"            # Use 80% of images for training
)

val_data=datagen.flow_from_directory(
    train_path,                  # Use the same training folder
    target_size=(150,150),       # Resize images to 150x150 pixels
    batch_size=32,               # Process 32 images at a time
    class_mode="binary",         # Use binary labels for 2 classes
    subset="validation"          # Use 20% of images for validation
)

test_datagen=ImageDataGenerator(
    rescale=1./255               # Normalize test image pixels to 0-1
)

test_data=test_datagen.flow_from_directory(
    test_path,                   # Path to the test image folder
    target_size=(150,150),       # Resize test images to 150x150 pixels
    batch_size=32,               # Process 32 images at a time
    class_mode="binary",         # Use binary labels for 2 classes
    shuffle=False                # Keep original order for evaluation
)

print("\nClass Indices:",train_data.class_indices)  # Display class names and their assigned numbers
                                                     #Class Indices: {'NORMAL': 0, 'PNEUMONIA': 1}
# ============================================================
# 5. SHOW SAMPLE IMAGES
# ============================================================
images,labels=next(train_data)                 # Get one batch of images and their labels

