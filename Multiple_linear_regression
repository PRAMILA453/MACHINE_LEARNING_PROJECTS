# ==========================================================
# INSURANCE CHARGES - MULTIPLE LINEAR REGRESSION
# ==========================================================

# 1. IMPORT LIBRARIES
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from google.colab import files
import seaborn as sns

# 2. LOAD DATASET
uploaded = files.upload()
df = pd.read_csv("insurance.csv")

print("First 5 rows:")
print(df.head())

# 3. CONVERT TEXT INTO NUMBERS
df["sex"] = df["sex"].map({"male": 0, "female": 1})
df["smoker"] = df["smoker"].map({"no": 0, "yes": 1})
df["region"] = df["region"].map({
    "southwest": 0,
    "southeast": 1,
    "northwest": 2,
    "northeast": 3
})

# 4. SELECT FEATURES AND TARGET
X = df[["age", "sex", "bmi", "children", "smoker", "region"]]
Y = df["charges"]

# 4.1 CORRELATION HEATMAP
plt.figure(figsize=(10, 6))
sns.heatmap(
    df[["age", "sex", "bmi", "children", "smoker", "region", "charges"]].corr(),
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)
plt.title("Correlation Heatmap")
plt.show()

# 5. SPLIT DATA
X_train, X_test, Y_train, Y_test = train_test_split(
    X, Y, test_size=0.2, random_state=42
)

# 6. CREATE AND TRAIN MODEL
model = LinearRegression()
model.fit(X_train, Y_train)

# 7. SHOW REGRESSION COEFFICIENTS
print("\nRegression Coefficients:")
print("b0 (Intercept) :", model.intercept_)
print("b1 (Age)       :", model.coef_[0])
print("b2 (Sex)       :", model.coef_[1])
print("b3 (BMI)       :", model.coef_[2])
print("b4 (Children)  :", model.coef_[3])
print("b5 (Smoker)    :", model.coef_[4])
print("b6 (Region)    :", model.coef_[5])

# 8. MAKE PREDICTIONS
Y_pred = model.predict(X_test)

# 9. ACTUAL VS PREDICTED VALUES
comparison = pd.DataFrame({
    "Actual": Y_test.values,
    "Predicted": Y_pred
})

print("\nActual vs Predicted:")
print(comparison.head(10))

# 10. ACTUAL VS PREDICTED LINE GRAPH
plt.figure(figsize=(10, 5))
plt.plot(range(20), Y_test.values[:20], marker="o", label="Actual")
plt.plot(range(20), Y_pred[:20], marker="o", label="Predicted")
plt.title("Actual vs Predicted Insurance Charges")
plt.xlabel("Test Customer")
plt.ylabel("Insurance Charges")
plt.legend()
plt.grid(True)
plt.show()

# 11. FEATURE EFFECT
effect = abs(model.coef_)

print("\nFeature Effect:")
for i in range(len(X.columns)):
    print(X.columns[i], ":", effect[i])

# 12. FEATURE EFFECT BAR GRAPH
plt.figure(figsize=(8, 5))
plt.bar(X.columns, effect)
plt.title("Effect of Features on Insurance Charges")
plt.xlabel("Features")
plt.ylabel("Effect")
plt.grid(axis="y", alpha=0.3)
plt.show()

# 13. MODEL EVALUATION
mae = mean_absolute_error(Y_test, Y_pred)
mse = mean_squared_error(Y_test, Y_pred)
rmse = np.sqrt(mse)
r2 = r2_score(Y_test, Y_pred)

print("\nMODEL PERFORMANCE")
print("MAE :", mae)
print("MSE :", mse)
print("RMSE:", rmse)
print("R2 Score:", r2)

# 14. PREDICT FOR A NEW CUSTOMER
# Age = 40
# Sex = Female (1)
# BMI = 30
# Children = 2
# Smoker = Yes (1)
# Region = Southeast (1)

new_customer = [[40, 1, 30, 2, 1, 1]]
prediction = model.predict(new_customer)

print("\nNew Customer Insurance Charge:")
print(prediction[0])
